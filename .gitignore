# Build output (never commit local builds)
[Bb]in/
[Oo]bj/
[Dd]ist/
[Pp]ublish/
out/

# IDE / editor (may contain absolute paths)
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# MSBuild / NuGet intermediates (contain machine-specific paths)
project.lock.json
project.fragment.lock.json
artifacts/
*.nuget.props
*.nuget.targets

# Runtime data
*.pvf
# 根目录的 Script.pvf 作为版本化的 PVF 数据源，随发布复制到 dist（见 publish.bat）。
!/Script.pvf

# OS
.DS_Store
Thumbs.db
